{
  "expo": {
    "name": "memory.ai",
    "slug": "memory-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/memoryai.png",
    "android": {
      "package": "com.memoryai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/memoryai.png",
        "backgroundColor": "#6D28D9"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "memory.ai uses the microphone so you can dictate notes.",
          "speechRecognitionPermission": "memory.ai uses speech recognition to turn your voice into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}

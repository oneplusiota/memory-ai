{
  "expo": {
    "name": "memory.ai",
    "slug": "memory-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/memoryai.png",
    "android": {
      "package": "com.memoryai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/memoryai.png",
        "backgroundColor": "#6D28D9"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "memory.ai uses the microphone so you can dictate notes.",
          "speechRecognitionPermission": "memory.ai uses speech recognition to turn your voice into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickCapture",
              "label": "Quick capture",
              "description": "One tap to start dictating a note",
              "minWidth": "180dp",
              "minHeight": "58dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "scheme": "memoryai"
  }
}
